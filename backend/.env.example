# ==============================================================
# Mobile App Security Analyzer - Backend Environment Variables
# ==============================================================
# Copy this file to 'backend/.env'
# NEVER commit real passwords or secrets to version control.
# ==============================================================

PORT=5000
NODE_ENV=production

# Database Configuration (MySQL 8.0+)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mobile_security_analyzer
DB_USER=
DB_PASSWORD=

# JWT Authentication (Min 32 random characters in production)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# File Storage Configuration
UPLOAD_DIR=./uploads
REPORT_DIR=./reports
MAX_FILE_SIZE_MB=200

# Security Analysis Engine (Python executable path)
PYTHON_PATH=python

# Client URL (for CORS validation)
CLIENT_URL=http://localhost:5173

# Optional: Initial Admin Account Configuration
ADMIN_EMAIL=
ADMIN_PASSWORD=
