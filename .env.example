# ==============================================================
# Mobile App Security Analyzer - Environment Configuration
# ==============================================================
# IMPORTANT:
# - Copy this file to '.env' before running the application.
# - DO NOT commit real secrets or passwords to version control.
# - In production, JWT_SECRET must be at least 32 random characters.
# ==============================================================

# Application Environment ('development' | 'production' | 'test')
NODE_ENV=production
PORT=5000

# Database Configuration (MySQL 8.0+)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mobile_security_analyzer
DB_USER=
DB_PASSWORD=

# JWT Authentication
# Generate a secure 32+ character key, e.g.: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# File Storage Configuration
UPLOAD_DIR=./uploads
REPORT_DIR=./reports
MAX_FILE_SIZE_MB=200

# Python Static Analysis Engine
PYTHON_PATH=python

# Client Application URL (for CORS validation)
CLIENT_URL=http://localhost:5173

# Optional: Initial Administrator Bootstrap
# (Used only for initial provisioning in secure environments)
ADMIN_EMAIL=
ADMIN_PASSWORD=
